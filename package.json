{
  "name": "rental-equipment-tracking",
  "version": "1.0.0",
  "private": true,
  "description": "Rental Equipment Tracking & Condition Logging with Automated Repair Billing",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "cds deploy --to hana",
    "setup:sqlite": "cds deploy --to sqlite:db.sqlite && node scripts/seed.js",
    "start": "cds bind --exec -- cds-serve --profile hybrid",
    "dev": "cds bind --exec -- cds-serve --profile hybrid",
    "watch": "cds bind --exec -- cds-serve --profile hybrid",
    "seed": "cds bind --exec -- node scripts/seed.js",
    "build": "cds build --production && node scripts/copy-app.js",
    "deploy:local": "cds deploy --to sqlite:db.sqlite",
    "lint": "eslint srv test scripts app --ext .js,.ts",
    "typecheck": "node -e \"require('fs').accessSync('srv/domain/lifecycle.js'); console.log('typecheck: JS domain present')\"",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "secret-scan": "node scripts/secret-scan.js",
    "ci": "npm run lint && npm run typecheck && npm test && npm run secret-scan && npm run build"
  },
  "dependencies": {
    "@cap-js/hana": "^3.1.2",
    "@sap/cds": "^10.2.1",
    "@sap/xssec": "^4.12.1",
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.1.2",
    "@sap/cds-dk": "^10.2.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "eslint": "^10.13.0",
    "globals": "^16.4.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "impl": "./srv/auth/session-auth.js"
        },
        "[hybrid]": {
          "impl": "./srv/auth/session-auth.js"
        },
        "[production]": { "kind": "xsuaa" }
      },
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": { "url": "db.sqlite" },
          "impl": "@cap-js/sqlite"
        },
        "[hybrid]": { "kind": "hana" },
        "[production]": { "kind": "hana" }
      }
    },
    "server": { "port": 4004 }
  }
}
